# ═══ VCDS.de — Environment Variables (Self-Hosted) ═══

# ──────────────────────────────────────────────
# PFLICHT — ohne diese startet die Seite nicht
# ──────────────────────────────────────────────

# Payload CMS Secret (min. 32 Zeichen, zufaellig generieren)
# Generieren: openssl rand -hex 32
PAYLOAD_SECRET=

# Site URL (eure Domain, mit https)
SITE_URL=https://vcds.de
NEXT_PUBLIC_SITE_URL=https://vcds.de

# ──────────────────────────────────────────────
# DATENBANK — Standard ist SQLite (empfohlen)
# ──────────────────────────────────────────────

# SQLite (lokal im Container, keine weitere Config noetig):
DATABASE_URI=file:/app/data/database.db

# ──────────────────────────────────────────────
# E-MAIL — Kontaktformular (optional)
# ──────────────────────────────────────────────

# Resend (resend.com) fuer E-Mail-Versand
# Ohne diese Keys werden Anfragen nur im CMS gespeichert, nicht per Mail verschickt
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_DOMAIN=vcds.de
# CONTACT_EMAIL_TO=support@vcds.de

# ──────────────────────────────────────────────
# BOT-SCHUTZ — Kontaktformular (optional)
# ──────────────────────────────────────────────

# Cloudflare Turnstile (kostenlos, DSGVO-konform)
# Registrieren: dash.cloudflare.com/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ──────────────────────────────────────────────
# DRAFT PREVIEW (optional)
# ──────────────────────────────────────────────

# Eigenes Secret fuer Draft-Vorschau (ohne dieses wird PAYLOAD_SECRET genutzt)
# DRAFT_SECRET=ein-weiterer-geheimer-schluessel

# ──────────────────────────────────────────────
# ANALYTICS (optional, DSGVO-konform)
# ──────────────────────────────────────────────

# Umami Analytics (cookieless, self-hosted oder Cloud)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=https://analytics.vcds.de/script.js
