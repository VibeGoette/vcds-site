# ═══ VCDS.de — Environment Variables ═══

# Payload CMS (PFLICHT)
PAYLOAD_SECRET=hier-mindestens-32-zeichen-langer-geheimer-schluessel

# Draft Preview Secret (empfohlen: separates Secret, damit kopierte Preview-URLs
# nicht das Haupt-PAYLOAD_SECRET enthalten). Fallback: PAYLOAD_SECRET.
DRAFT_SECRET=anderes-secret-fuer-live-preview-urls

# Datenbank
# Lokal (SQLite):
DATABASE_URI=file:./data/database.db
# Produktion (Turso/LibSQL):
# DATABASE_URI=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# Site URL
SITE_URL=https://vcds.de
NEXT_PUBLIC_SITE_URL=https://vcds.de

# Optional: Resend fuer E-Mail-Versand (Kontaktformular)
# RESEND_API_KEY=re_...
# RESEND_DOMAIN=vcds.de
# CONTACT_EMAIL_TO=support@vcds.de

# Optional: Umami Analytics (cookieless, DSGVO-konform)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=https://analytics.vcds.de

# Optional: zusaetzliche erlaubte Hosts fuer das Umami-Analytics-Script.
# Kommagetrennte Liste. Die Defaults sind bereits: umami.is, cloud.umami.is, analytics.vcds.de
# UMAMI_ALLOWED_HOSTS=stats.example.com,analytics.example.de

# Optional: Upstash Redis for distributed rate-limiting on /api/contact (SEC-05)
# Sign up at https://upstash.com/, create a Redis database, copy the REST URL + token.
# Without these, the in-memory Map fallback is used (resets on every Vercel cold start).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
